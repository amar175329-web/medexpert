# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key # Server-only

# Upstash Redis (rate limiting & caching)
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Sentry (PII scrubbing active, error tracking)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Web Push Notifications (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@medexpert.local

# Transactional Notifications
RESEND_API_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Internal Cron Security
CRON_SECRET=development-cron-secret-change-in-prod

# AI Layer & Model Lifecycle
AI_PROVIDER=mock # 'local-bridge' in production/local with bridge, 'mock' for tests
AI_BRIDGE_URL=http://127.0.0.1:3001
AI_BRIDGE_TOKEN=development-bridge-token
AI_REQUEST_TIMEOUT_MS=60000
MODEL_IDLE_SECONDS=300

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
